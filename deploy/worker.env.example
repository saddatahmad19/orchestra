# Copy to ~/.config/orchestra/worker.env and chmod 600.
# Use the Pi's private Tailscale Serve URL; do not use a public endpoint.
ORCHESTRA_SERVER_URL=http://replace-with-pi-tailscale-ip:8788
ORCHESTRA_WORKER_TOKEN=replace-with-the-worker-token-from-the-pi
ORCHESTRA_WORKER_ID=thinkpad-x1
ORCHESTRA_WORKER_NAME=ThinkPad-X1

# Colon-separated absolute paths. Only directories under these roots can be used.
ORCHESTRA_PROJECT_ROOTS=/replace/with/your/approved/projects

# JSON object: engine ID -> exact argv array. Verify each CLI's installed help first.
# A {prompt} token is replaced with the task prompt; otherwise prompt is sent on stdin.
# Do not copy guessed CLI flags into this file.
ORCHESTRA_EXECUTORS={}

ORCHESTRA_WORKER_POLL_SECONDS=4
ORCHESTRA_WORKER_HEARTBEAT_SECONDS=30
ORCHESTRA_WORKER_MAX_RUNTIME_SECONDS=3600

# Optional comma-separated names of extra environment variables needed by a verified CLI.
# Never use '*' or dump values to logs.
ORCHESTRA_WORKER_ENV_ALLOWLIST=
