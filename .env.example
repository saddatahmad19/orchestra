ORCHESTRA_ADMIN_TOKEN=replace-with-32-plus-random-characters
ORCHESTRA_WORKER_TOKEN=use-a-different-32-plus-random-secret
ORCHESTRA_DATABASE=/data/orchestra.sqlite3
# Keep loopback by default. Set to the Pi's Tailscale IP for direct tailnet-only access.
ORCHESTRA_BIND_ADDRESS=127.0.0.1
ORCHESTRA_LOG_LEVEL=INFO
ORCHESTRA_TASK_LEASE_SECONDS=180
ORCHESTRA_MAX_TASK_RUNTIME_SECONDS=3600
